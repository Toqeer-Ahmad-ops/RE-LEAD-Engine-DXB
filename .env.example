# RE-LEAD-Engine-DXB - Day 10 .env.example
# Copy to .env and fill real values. NEVER commit .env

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Qdrant RAG ---
QDRANT_URL=https://your-qdrant-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_DXB=dxb_real_estate_knowledge

# --- Google Gemini ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# --- Groq Whisper ---
GROQ_API_KEY=your-groq-api-key
GROQ_WHISPER_MODEL=whisper-large-v3

# --- WhatsApp - Whapi.Cloud ---
WHAPI_API_URL=https://gate.whapi.cloud
WHAPI_TOKEN=your-whapi-token

# --- 【entity-HubSpot¦canonical_name=HubSpot】 CRM Sync ---
HUBSPOT_API_KEY=your-【entity-hubspot¦canonical_name=HubSpot】-private-app-token

# --- Day 10: Reliability Layer (NEW) ---
CENTRAL_ERROR_WORKFLOW_ID=your-error-workflow-id
ERROR_LOG_TABLE=error_logs
RETRY_MAX_ATTEMPTS=3
IDEMPOTENCY_TABLE=idempotency_keys

# --- Day 10: Follow-up Engine (NEW) - 3x24h ---
FOLLOWUP_MAX_ATTEMPTS=3
FOLLOWUP_DELAY_HOURS=24,48,72
FOLLOWUP_TABLE=follow_up_logs

# --- Day 10: Human Handoff + SLA (NEW) ---
HANDOFF_TABLE=handoff_logs
HANDOFF_SLA_MINUTES=15
HANDOFF_NOTIFY_EMAIL=toqeer.digitizer@gmail.com